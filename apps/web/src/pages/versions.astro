---
import Base from '../layouts/Base.astro';
---

<Base title="Versions — quick-html-sharing">
  <h1>Versions</h1>
  <p class="lede" id="slug-line">Loading…</p>

  <p class="error" id="error-msg" hidden></p>
  <p class="muted" id="status-msg" role="status" aria-live="polite" hidden></p>

  <ul id="version-list" class="versions" hidden></ul>

  <div class="row" style="margin-top: 24px">
    <a id="open-share" href="#" target="_blank" rel="noopener">Open share &rarr;</a>
    <a href="/my-shares">&larr; My Shares</a>
  </div>

  <style>
    .versions {
      list-style: none;
      padding: 0;
      margin: 16px 0 0;
    }
    .versions > li {
      border-top: 1px solid var(--border);
      padding: 12px 0;
    }
    .versions > li:last-child {
      border-bottom: 1px solid var(--border);
    }
    .version-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
    }
    .version-label {
      font-weight: 600;
    }
    .version-source {
      margin: 12px 0 0;
      padding: 12px;
      background: var(--panel-2);
      border-radius: var(--radius);
      font: 12px/1.5 var(--mono);
      white-space: pre-wrap;
      word-break: break-word;
      max-height: 320px;
      overflow: auto;
    }
    .versions button:focus-visible,
    .versions a:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }
  </style>

  <script>
    import {
      listVersions,
      getVersionSource,
      restoreVersion,
      ApiError,
      type VersionCredentials,
    } from '../lib/api';
    import { loadSyncKey } from '../lib/synckey';

    const params = new URLSearchParams(location.search);
    const slug = params.get('slug') ?? '';
    const slugLine = document.getElementById('slug-line') as HTMLElement;
    const errorMsg = document.getElementById('error-msg') as HTMLElement;
    const statusMsg = document.getElementById('status-msg') as HTMLElement;
    const list = document.getElementById('version-list') as HTMLUListElement;
    const openShare = document.getElementById('open-share') as HTMLAnchorElement;

    /**
     * Either credential works. The edit token arrives in the fragment (never a
     * query string — fragments are not sent to servers or logged), which is how
     * the edit page hands off. Coming from My Shares there is no token on this
     * device, only the sync key, and that is exactly the cross-device case this
     * page has to support.
     */
    function credentials(): VersionCredentials | null {
      const editToken = new URLSearchParams(location.hash.slice(1)).get('edit');
      if (editToken) return { editToken };
      const syncKey = loadSyncKey();
      if (syncKey) return { syncKey };
      return null;
    }

    function showError(message: string) {
      errorMsg.textContent = message;
      errorMsg.hidden = false;
    }

    function announce(message: string) {
      statusMsg.textContent = message;
      statusMsg.hidden = false;
    }

    function apiMessage(e: unknown, fallback: string): string {
      return e instanceof ApiError ? e.message : fallback;
    }

    function formatSize(bytes: number): string {
      return bytes < 1024 ? `${bytes} B` : `${Math.round(bytes / 102.4) / 10} KB`;
    }

    function makeRow(
      entry: { version: number; createdAt: string; contentSize: number },
      isCurrent: boolean,
      creds: VersionCredentials,
    ): HTMLLIElement {
      const li = document.createElement('li');

      const head = document.createElement('div');
      head.className = 'version-head';

      const left = document.createElement('div');
      const label = document.createElement('div');
      label.className = 'version-label';
      label.textContent = isCurrent ? `Version ${entry.version} (current)` : `Version ${entry.version}`;
      const meta = document.createElement('div');
      meta.className = 'muted';
      meta.textContent = `${new Date(entry.createdAt).toLocaleString()} · ${formatSize(entry.contentSize)}`;
      left.append(label, meta);

      const actions = document.createElement('div');
      actions.className = 'row';

      const source = document.createElement('pre');
      source.className = 'version-source';
      source.hidden = true;

      const preview = document.createElement('button');
      preview.className = 'secondary';
      preview.type = 'button';
      preview.textContent = 'view source';
      let loaded = false;
      preview.addEventListener('click', async () => {
        if (loaded) {
          source.hidden = !source.hidden;
          preview.textContent = source.hidden ? 'view source' : 'hide source';
          return;
        }
        preview.disabled = true;
        try {
          const text = await getVersionSource(slug, entry.version, creds);
          // textContent, never innerHTML: this is user HTML, and rendering it
          // on the dashboard origin is what the two-origin split exists to
          // prevent.
          source.textContent = text;
          loaded = true;
          source.hidden = false;
          preview.textContent = 'hide source';
        } catch (e) {
          showError(apiMessage(e, 'Could not load that version.'));
        } finally {
          preview.disabled = false;
        }
      });
      actions.append(preview);

      // No restore on the live version: it would append an identical copy and
      // quietly push a real older version out of the retention window.
      if (!isCurrent) {
        actions.append(makeRestoreButton(entry.version, creds));
      }

      head.append(left, actions);
      li.append(head, source);
      return li;
    }

    /** Two-step confirm, matching the inline delete pattern on My Shares. */
    function makeRestoreButton(version: number, creds: VersionCredentials): HTMLButtonElement {
      const btn = document.createElement('button');
      btn.className = 'secondary';
      btn.type = 'button';
      btn.textContent = 'restore';
      let armed = false;
      let revert: ReturnType<typeof setTimeout> | undefined;

      btn.addEventListener('click', async () => {
        if (!armed) {
          armed = true;
          btn.textContent = 'Confirm restore?';
          btn.className = 'danger';
          // Restoring republishes that version to everyone holding the link,
          // so the confirm step is the moment to reconsider — hence "view
          // source" sitting right next to it.
          revert = setTimeout(() => {
            armed = false;
            btn.textContent = 'restore';
            btn.className = 'secondary';
          }, 3000);
          return;
        }
        if (revert) clearTimeout(revert);
        btn.disabled = true;
        try {
          const result = await restoreVersion(slug, version, creds);
          announce(
            `Restored version ${result.restoredFrom} as version ${result.newVersion}. Nothing was deleted — you can restore any version again.`,
          );
          await load();
        } catch (e) {
          showError(apiMessage(e, 'Could not restore that version.'));
          btn.disabled = false;
          armed = false;
          btn.textContent = 'restore';
          btn.className = 'secondary';
        }
      });
      return btn;
    }

    async function load() {
      if (!slug) {
        // Nothing to name here, so clear the placeholder outright rather than
        // leaving "Loading…" above an error that will never resolve.
        slugLine.textContent = '';
        showError('Missing slug.');
        return;
      }

      // Name the share before the credential check. Every error path below
      // leaves this line on screen, and "Loading…" sitting above an error
      // reads as a page that hung rather than one that answered.
      slugLine.textContent = slug;

      const creds = credentials();
      if (!creds) {
        showError(
          'No credential on this device. Open this share from its edit link, or enter your sync code on My Shares first.',
        );
        return;
      }

      const shareBase = (import.meta.env.PUBLIC_SHARE_BASE as string | undefined) ?? '';
      openShare.href = shareBase ? `${shareBase}/${slug}` : `/${slug}`;

      try {
        const data = await listVersions(slug, creds);
        errorMsg.hidden = true;
        list.replaceChildren();
        for (const entry of data.versions) {
          list.append(makeRow(entry, entry.version === data.latestVersion, creds));
        }
        list.hidden = false;
        if (data.versions.length === 1) {
          announce('Only one version so far. Editing this share will keep the current one here.');
        }
      } catch (e) {
        list.hidden = true;
        showError(apiMessage(e, 'Could not load versions.'));
      }
    }

    void load();
  </script>
</Base>
